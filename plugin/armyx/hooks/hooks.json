    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node --experimental-strip-types --no-warnings \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.mjs\" auto prompt auto", "timeout": 15 }] }
